#!/usr/bin/env python3
"""pre-commit hook: refuse any commit whose staged file content contains the
unescaped HERMES trigger byte sequence.

Scans the FULL blob of every staged file (not just the diff lines) so that
pasting contaminated content into an otherwise-unchanged file is also caught.
Binary files are scanned at the byte level — no decode step, no exclusions.

Source-cleanliness convention: the trigger byte sequence is never written
contiguously in this source file.  The compiled pattern in `tools._git_utils`
uses `rb"HERMES\\.md"` (backslash escapes the dot in the regex, but the
source bytes H-E-R-M-E-S-backslash-.-m-d contain a backslash between S and
the dot — so the contiguous 9-byte trigger never appears in this file's
source).  Verification: `grep -cF` for the unescaped form against this file
must return 0.

Also runs the T-2314 main-guard lint (`tools/main_guard_lint.py`) against the
STAGED BLOB content of staged `tools/*.py` files only — catches top-level
definitions stranded below a `__main__` guard at authoring time, on every
seat, closing the trigger gap the pytest live-tree test (the --no-verify /
hookless-clone backstop) leaves open for direct-to-main pushes. Fail-OPEN on
any infrastructural error (import/decode/ast failure — see
`_main_guard_lint_findings`); fail-CLOSED on an actual finding.

Also runs the T-2650 ledger JSON-validity check
(`tools/ledger_placement_lint.py --staged` / `lint_staged_validity`) against
ledger lines newly ADDED in the staged diff under `ledger/**/*.jsonl` —
catches a missing-`}` (or otherwise unparseable/non-object) entry at commit
time, before it ever reaches origin/main (see `_ledger_validity_findings`).
Scoped to added lines only, so it can never block on pre-existing/legacy
ledger content. Fail-OPEN on any infrastructural error (import/scan
failure); fail-CLOSED on a genuinely unparseable added line.

Also runs the T-3020 BT4 priority-list validation
(`tools/ticket.py`'s `_priority_list_validate_report` via
`_priority_list_validate_findings`) against the WORKING-TREE
`rulebook/priority-list.md` whenever it is staged — rejects a commit that
would land a broken (unparseable) priority-list (ORG-078 §4); a
probably-dead-label finding is printed as a non-blocking warning. Runs
IN-PROCESS (imports `tools.ticket`), not via subprocess, because
`ticket.py`'s CLI entry point refuses to run from an `agent/*` branch.

Also runs the T-4402 content-drift gate (`tools/staged_content_gate.py` via
`_content_gate_findings`) when a staged path is a `tickets/{inbox,active}/T-*.md`
file or `knowledge/watch/topics.md`: the two content-coupled invariants that turned
the nightly CI run red for 20 days (a non-done ticket's `project_id` with no
justifying label / ticket-chain hop; an ACTIVE watch topic with no TOPIC_POLICY
entry) are evaluated against the STAGED blobs, so the commit that would break them
is refused at the writer. Blocks only a violation INTRODUCED by the commit
(compared with HEAD, following a rename to its source), so a pre-existing red
never locks unrelated ticket operations. Fail-OPEN on any infrastructural error;
fail-CLOSED on an introduced finding.

Renames are checked like any other staged file (T-4451). A `git mv` plus an edit is
status R -- what `ticket.py claim` / `unclaim` / `resolve` commit -- and used to be
dropped by the staged-list filter, so the renamed blob skipped every check above.
`_staged_changes()` now lists the DESTINATION path together with its rename source.
Whole-blob checks (the byte-sequence scan, the main-guard lint) scan the destination
blob exactly as for an added or modified file. Checks with a baseline (the content
gate, the self-sudo guard, the ledger validity check) compare against the file's
pre-rename identity, so a pure rename of a pre-existing finding is not newly blocked
while a rename that ADDS a violation still is. Copies are never given that credit:
the hook pins `-M`, which lists a copy as an added file (see `_staged_changes`).

Activation:
    git config core.hooksPath .githooks
    (or run tools/install_hooks.sh which does this idempotently)
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# Bootstrap: add repo root to sys.path so `tools._git_utils` is importable
# regardless of cwd.
# ---------------------------------------------------------------------------

_HOOK = Path(__file__).resolve()
_REPO_ROOT = _HOOK.parent.parent  # .githooks/../ == repo root
sys.path.insert(0, str(_REPO_ROOT))

from tools._git_utils import _HERMES_PATTERN  # noqa: E402


def _staged_changes() -> list[tuple[str, str | None]]:
    """Return `(path, rename_source)` for every staged file (added / copied /
    modified / renamed; not deleted). `path` is what the commit CREATES, so a
    renamed file is listed under its DESTINATION and `rename_source` is the path
    it was renamed from; every other entry has `rename_source` None.

    T-4451: renames are included. A `git mv` plus an edit is status R, which the
    former `--diff-filter=ACM` dropped, so the renamed blob skipped the byte-
    sequence scan and every staged-content gate (`ticket.py claim` / `unclaim` /
    `resolve` commit exactly that shape). Whole-blob checks now scan the
    destination like any A/M path; baselined checks use `rename_source` to compare
    against the file's HEAD blob under its OLD name.

    Rename detection is pinned on (`-M`) rather than left to the seat's
    `diff.renames` config. It also pins copies OFF: `-M` overrides
    `diff.renames=copies`, so a copy is listed as an ADDED file with no source. That
    is deliberate -- a copy leaves its source in place, so its findings are
    duplicated, not relocated, and it gets no pre-existing-finding credit. (`C` stays
    in the filter letters only so a future `-C` cannot silently drop it.)

    Parsed from `--name-status -z`: `<status>\\0<path>\\0` for most statuses,
    `<R|C><score>\\0<old>\\0<new>\\0` for renames and copies. A truncated tail is
    dropped rather than guessed at. Fail-OPEN like the rest of the hook: a failing
    `git` yields `[]`.

    T-2325: uses `-z` (NUL-separated, no quoting) rather than the default
    line-based output. With `core.quotePath` at its default, a path git
    considers unusual comes back ESCAPED AND DOUBLE-QUOTED — a file named
    `tools/bad_<non-utf8>_name.py` renders as a string whose first character is
    a literal `"`. Two consumers then silently skip it: `_main_guard_lint_
    findings` filters on `p.startswith("tools/")`, which is false for the
    quoted form, and `_read_staged_blob` hands the bogus path to `git show`,
    which fails and returns None. The byte-sequence half is the one that
    matters — that is a path by which contaminated content reaches a commit
    with this guard never having read it.

    Fixed at intake rather than by un-escaping downstream, so both consumers
    are repaired at once and neither has to know `core.quotePath` exists.

    Decoded with surrogateescape so a non-UTF-8 filename survives the round
    trip: subprocess re-encodes these strings back to the original bytes on
    POSIX, so `git show :<path>` in `_read_staged_blob` still resolves.
    """
    result = subprocess.run(
        ["git", "diff", "--cached", "-M", "--name-status", "--diff-filter=ACMR", "-z"],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return []
    tokens = result.stdout.decode("utf-8", "surrogateescape").split("\0")
    changes: list[tuple[str, str | None]] = []
    i = 0
    while i < len(tokens) and tokens[i]:
        if tokens[i][0] in "RC":
            if i + 2 >= len(tokens) or not tokens[i + 1] or not tokens[i + 2]:
                break
            changes.append((tokens[i + 2], tokens[i + 1] if tokens[i][0] == "R" else None))
            i += 3
        else:
            if i + 1 >= len(tokens) or not tokens[i + 1]:
                break
            changes.append((tokens[i + 1], None))
            i += 2
    return changes


# `\Z`, not `$` (T-4541): `$` also matches before a trailing newline, and `T-N.md\n` is
# not a ticket (the corpus globs `T-*.md`).
_TICKET_PATH_RE = re.compile(r"^tickets/[^/]+/(T-\d+)\.md\Z")


def _ticket_id_sources(changes: list[tuple[str, str | None]]) -> dict[str, str]:
    """T-4470: `{dest: source}` for staged ticket files `-M` left unpaired, resolved by
    ticket id from the staged deletions.

    `-M` only pairs a move at >=50% similarity. A `ticket.py claim` / `resolve` that
    rewrites enough of the file (a long log section replacing a short one) falls under
    that, so git reports an A plus a D and the destination has no `rename_source`: the
    baselined checks then read a legitimate claim of a pre-existing-red ticket as
    INTRODUCING its finding and refuse it. A ticket's file name is its id (`T-N.md`)
    and the id is unique, so the one staged deletion carrying the same id IS the file
    this addition moved from.

    Credit only when unambiguous: exactly one staged ADDED and exactly one staged
    DELETED `tickets/*/T-N.md` carry the id (two deletions leave the baseline
    undecidable; two additions would be a copy, which the hook never credits -- see
    `_staged_changes`). Every staged ticket git did not pair (`source is None`) runs
    the lookup: a moved-and-rewritten A, but also an M and a brand-new A, which get no
    credit (an M is not among the listed additions -- its baseline is its own HEAD
    blob -- and a new A has no same-id deletion). That costs those commits one extra
    git call, kept for simplicity. Fail-CLOSED (`{}`, i.e. no credit, today's behaviour) on any git error or malformed
    output, unlike the fail-open rest of the hook: this lookup can only WIDEN what a
    commit is allowed, so a doubt must not widen it.
    """
    unpaired = {
        path: match.group(1)
        for path, source in changes
        if source is None and (match := _TICKET_PATH_RE.match(path))
    }
    if not unpaired:
        return {}
    result = subprocess.run(
        ["git", "diff", "--cached", "-M", "--name-status", "--diff-filter=AD", "-z"],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return {}
    tokens = result.stdout.decode("utf-8", "surrogateescape").split("\0")
    if tokens and tokens[-1] == "":
        tokens.pop()
    if len(tokens) % 2:
        return {}
    added: dict[str, list[str]] = {}
    deleted: dict[str, list[str]] = {}
    for status, path in zip(tokens[0::2], tokens[1::2]):
        match = _TICKET_PATH_RE.match(path)
        if status not in ("A", "D") or not match:
            continue
        (added if status == "A" else deleted).setdefault(match.group(1), []).append(path)
    return {
        path: deleted[tid][0]
        for path, tid in unpaired.items()
        if len(added.get(tid, ())) == 1 and added[tid][0] == path and len(deleted.get(tid, ())) == 1
    }


def _rename_map(changes: list[tuple[str, str | None]]) -> dict[str, str]:
    """The `{destination: baseline source}` map every baselined check compares against:
    git's `-M` renames, plus (T-4470) the ticket-id sources of `_ticket_id_sources`."""
    sources = {path: source for path, source in changes if source is not None}
    for path, source in _ticket_id_sources(changes).items():
        sources.setdefault(path, source)
    return sources


def _staged_files() -> list[str]:
    """Staged file paths (added / copied / modified / renamed -- a rename is listed
    under its destination; deleted paths are not). See `_staged_changes`."""
    return [path for path, _source in _staged_changes()]


def _read_staged_blob(path: str) -> bytes | None:
    """Read the staged (index) blob for `path` via `git show :<path>`.

    Returns None if the path is not in the index (should not happen after
    --diff-filter=ACMR, but defensive).
    """
    result = subprocess.run(
        ["git", "show", f":{path}"],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return result.stdout


def _scan_blob(blob: bytes, label: str) -> tuple[bool, str | None]:
    """Return (ok, detail).  detail is '<label>:<lineno>' on match."""
    m = _HERMES_PATTERN.search(blob)
    if m:
        lineno = blob[: m.start()].count(b"\n") + 1
        return False, f"{label}:{lineno}"
    return True, None


def _warn_directive_drift(staged: list[str]) -> None:
    """Non-blocking drift tripwire (T-0796).

    When rulebook/directives.md is staged, run the directive<->skill drift guard
    and surface any drift as a WARNING. The canonical pantheon-org-discipline
    skill lives in harness/claude/ since ORG-091 (T-4750; a fork may keep it in a
    separate harness-config repo), and a directives.md change may land before its
    skill update — hence warn, not block. This local hook just makes the
    staleness loud at the moment directives.md moves.
    """
    if "rulebook/directives.md" not in staged:
        return
    script = _REPO_ROOT / "tools" / "directive_skill_drift_check.py"
    if not script.exists():
        return
    result = subprocess.run(
        [sys.executable, str(script)],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        print("", file=sys.stderr)
        print("directive<->skill drift WARNING (non-blocking):", file=sys.stderr)
        for line in result.stdout.splitlines() + result.stderr.splitlines():
            if line.strip():
                print(f"  {line}", file=sys.stderr)
        print(
            "  -> update the pantheon-org-discipline skill (harness/claude/skills/ in this repo, "
            "or your fork's harness-config repo) before workers rely on the new D-id. Commit is allowed. "
            "(A fork without a harness-config repo gets a clean SKIP, not this warning — ORG-039 §4.)",
            file=sys.stderr,
        )
        print("", file=sys.stderr)


def _main_guard_lint_findings(staged: list[str]) -> list[str] | None:
    """Staged-blob main-guard lint (T-2314).

    Returns a list of human-readable finding strings (empty list = clean), or
    None only when the `main_guard_lint` module itself is unavailable (import
    error) — that is a single SHARED dependency, so an import failure blinds
    every file identically and there is nothing left to scan.  Fail-OPEN,
    mirroring `_hook_allowlist_drift`'s `except Exception: return None` shape
    below, because this hook gates every seat's commits fleet-wide (the
    T-1102 blast radius: a lint bug here must never brick filing).

    Per-file errors (a staged blob that fails to read or decode, or a
    `lint_source` crash on one specific file's `ast` parse) are caught PER
    FILE inside the scan loop, not around the whole loop — an infrastructural
    problem on one staged file must not discard a real finding already
    computed on a different staged file in the same commit (round-1 REBOUND:
    the wide-try shape let a garbage-bytes sibling file silently swallow a
    genuine violation). Each per-file failure prints its own warning naming
    the path and continues scanning the rest; the overall return is still a
    (possibly non-empty) list, never None, in that case.

    Only scans STAGED `tools/*.py` files via `_read_staged_blob` (not
    whatever happens to be on disk), so an inherited dirty tree can never
    block an unrelated commit — same scoping as the HERMES scan above.
    """
    targets = [p for p in staged if p.startswith("tools/") and p.endswith(".py")]
    if not targets:
        return []

    try:
        from tools.main_guard_lint import lint_source
    except Exception as exc:  # fail-OPEN: whole module unavailable, nothing to scan
        print(
            "main-guard lint WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — main_guard_lint unavailable, "
            "SKIPPING main-guard lint entirely, commit allowed",
            file=sys.stderr,
        )
        return None

    findings: list[str] = []
    for path in targets:
        try:
            blob = _read_staged_blob(path)
            if blob is None:
                continue
            src = blob.decode("utf-8")
            for f in lint_source(src, path):
                findings.append(
                    f"{path}:{f.lineno}  {f.name} ({f.kind}) — stranded below "
                    f"the __main__ guard opening at line {f.guard_lineno}"
                )
        except Exception as exc:  # fail-OPEN per file: one bad file must not
            # blind the scan to a real finding on a sibling staged file.
            print(
                "main-guard lint WARNING (non-blocking, fail-open): "
                f"{path}: {exc.__class__.__name__}: {exc} — SKIPPING "
                "main-guard lint for this file, commit allowed for it",
                file=sys.stderr,
            )
            continue
    return findings


def _self_sudo_guard_findings(
    staged: list[str], rename_sources: dict[str, str] | None = None
) -> list[str] | None:
    """Staged-blob self-sudo-guard lint (T-4032).

    Flags a NEW per-seat `sudo -u <var>` construction that lacks an own-account
    (getpass.getuser()/os.getuid()) guard — the self-sudo-to-own-account false-null class
    (bugs/sudo-u-to-runners-own-account-fails-per-seat-cross-account-tool-false-null.md).
    Pre-gate instances are grandfathered by the module's baseline, so only genuinely NEW
    unguarded constructions block. Same fail-OPEN posture as `_main_guard_lint_findings`
    (whole-module unavailable -> None; per-file error -> skip that file, keep real
    findings on siblings), because this gates every seat's commits fleet-wide.

    Only scans STAGED `tools/*.py` + `tools/*.sh` (the shell half, T-4066; never test_*
    — the detector's own tests carry synthetic bad samples), via `_read_staged_blob`, so
    a dirty tree can't block an unrelated commit.

    T-4451: the baseline and ALLOWLIST are keyed by PATH, so a renamed file is
    judged under the path it was renamed FROM (`rename_sources`, {dest: source}) --
    otherwise a pure `git mv` of a grandfathered construction would read as a
    brand-new unguarded one. Findings are still reported under the destination
    path, and a construction the rename ADDS (a function not in the baseline) is
    still flagged. No map (None) means no renames are known: every path is judged
    under its own name.
    """
    targets = [p for p in staged
               if p.startswith("tools/") and p.endswith((".py", ".sh"))
               and not Path(p).name.startswith("test_")
               and "tests" not in Path(p).parts[1:-1]]  # same test-dir skip as scan()
    if not targets:
        return []

    try:
        from tools.self_sudo_guard_lint import (
            ALLOWLIST, lint_shell_source, lint_source, load_baseline)
    except Exception as exc:  # fail-OPEN: whole module unavailable, nothing to scan
        print(
            "self-sudo-guard lint WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — self_sudo_guard_lint unavailable, "
            "SKIPPING self-sudo-guard lint entirely, commit allowed",
            file=sys.stderr,
        )
        return None

    allowed = {rel for rel, _reason in ALLOWLIST}
    try:
        baseline = load_baseline(_REPO_ROOT)
    except Exception:
        baseline = frozenset()

    sources = rename_sources or {}
    findings: list[str] = []
    for path in targets:
        origin = sources.get(path, path)  # the path the baseline knows this file by
        if path in allowed or origin in allowed:
            continue
        try:
            blob = _read_staged_blob(path)
            if blob is None:
                continue
            src = blob.decode("utf-8")
            linter = lint_shell_source if path.endswith(".sh") else lint_source
            for f in linter(src, origin, baseline=baseline):
                findings.append(
                    f"{path}:{f.lineno}  {f.func} — {f.detail}"
                )
        except Exception as exc:  # fail-OPEN per file
            print(
                "self-sudo-guard lint WARNING (non-blocking, fail-open): "
                f"{path}: {exc.__class__.__name__}: {exc} — SKIPPING "
                "self-sudo-guard lint for this file, commit allowed for it",
                file=sys.stderr,
            )
            continue
    return findings


def _ledger_validity_findings(staged: list[str]) -> list[str] | None:
    """Staged ledger JSON-validity findings (T-2650).

    Returns a list of human-readable finding strings (empty list = clean), or
    None only when the check itself could not run (import failure, or an
    unexpected exception from the scan) -- fail-OPEN, mirroring
    `_main_guard_lint_findings`'s exact shape: a broken guard must never brick
    a ledger commit. `lint_staged_validity` is ALSO internally fail-open on
    every `git`-command failure (bad repo state, etc.), so this outer guard
    only needs to catch an import problem or a genuine bug in the scan itself.

    Cheap-skips (returns `[]` without importing anything) when no staged path
    starts with `ledger/` -- the overwhelmingly common commit.

    Only ever BLOCKS on a genuinely unparseable/non-object line newly ADDED
    to a `ledger/**/*.jsonl` path in this commit (see
    `ledger_placement_lint.lint_staged_validity`'s added-lines-only scoping)
    -- it can never fire on pre-existing/legacy ledger content.
    """
    if not any(p.startswith("ledger/") for p in staged):
        return []

    try:
        from tools.ledger_placement_lint import (
            format_validity_lines,
            lint_staged_org001,
            lint_staged_validity,
        )
    except Exception as exc:  # fail-OPEN: module unavailable, nothing to scan
        print(
            "ledger-validity WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — ledger_placement_lint unavailable, "
            "SKIPPING ledger validity check, commit allowed",
            file=sys.stderr,
        )
        return None

    try:
        invalid = lint_staged_validity(repo_root=_REPO_ROOT)
    except Exception as exc:  # fail-OPEN: belt-and-suspenders over the
        # function's own internal fail-open, for a genuine bug in the scan.
        print(
            "ledger-validity WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — SKIPPING ledger validity "
            "check, commit allowed",
            file=sys.stderr,
        )
        return None

    # T-4739: ORG-001 rules on the same added lines (pre-existing rows grandfathered).
    try:
        invalid = invalid + lint_staged_org001(repo_root=_REPO_ROOT)
    except Exception as exc:  # fail-OPEN, like the scan above
        print(
            "ledger-org001 WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — SKIPPING the ORG-001 check on staged "
            "ledger lines, commit allowed",
            file=sys.stderr,
        )
    return format_validity_lines(invalid)


def _priority_list_validate_findings(staged: list[str]) -> list[str] | None:
    """Staged priority-list validation (T-3020 BT4, ORG-078 §4).

    When `rulebook/priority-list.md` is staged, validate the WORKING-TREE
    file (not the staged blob — `_priority_list_validate_report` reads off
    disk via `priority_list_parse.parse_file()`'s default path, same as
    `ticket.py list` itself; ORG-078 §4 names the working-tree file
    explicitly). Imports `tools.ticket` and calls its report function
    IN-PROCESS rather than subprocessing `python3 tools/ticket.py
    priority-list validate` — `ticket.py`'s `main()` refuses to run from any
    `agent/*` branch (`_assert_cli_checkout_allowed`), so a subprocess
    invocation would false-block every priority-list edit committed from an
    agent worktree, exactly backwards for a safety gate. In-process import
    matches this hook's existing `_main_guard_lint_findings`/
    `_ledger_validity_findings` shape.

    Returns BLOCKING finding strings (empty = clean or warn-only), or None
    when the check itself couldn't run (fail-open — an import/scan bug here
    must never brick an unrelated commit, mirroring the other findings
    functions above). Cheap-skips (`[]`, no import) when priority-list.md
    isn't staged.

    A warning (exit 2 from the report — dead-label, high-volume, or
    semantic-drift-candidate as of T-3080) is printed directly here,
    non-blocking (mirrors `_warn_directive_drift`'s shape) — it never
    affects `main()`'s block decision, only a parse failure (exit 1) does.
    """
    if "rulebook/priority-list.md" not in staged:
        return []

    try:
        from tools.ticket import _priority_list_validate_report
    except Exception as exc:  # fail-OPEN: module unavailable, nothing to scan
        print(
            "priority-list-validate WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — tools.ticket unavailable, "
            "SKIPPING priority-list validation, commit allowed",
            file=sys.stderr,
        )
        return None

    try:
        code, lines = _priority_list_validate_report()
    except Exception as exc:  # fail-OPEN: a genuine bug in the check itself
        print(
            "priority-list-validate WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — SKIPPING priority-list "
            "validation, commit allowed",
            file=sys.stderr,
        )
        return None

    if code == 1:
        return [f"rulebook/priority-list.md: {line}" for line in lines]

    if code == 2:
        print("", file=sys.stderr)
        print("priority-list WARNING (non-blocking):", file=sys.stderr)
        for line in lines:
            print(f"  {line}", file=sys.stderr)
        print("", file=sys.stderr)

    return []


def _instance_yaml_binding_findings(staged: list[str]) -> list[str] | None:
    """Staged instance.yaml role-binding two-surface smoke gate (T-3281, ORG-012 §6).

    When `instance.yaml` is staged (typically a role-binding edit), run
    `tools.test_instance_role_grants` and `tools.test_agent_role_map`
    in-process to close the procedural gap
    `bugs/instance-yaml-role-binding-key-needs-fallback-mirror.md`
    documents: a `roles.<role>` key in instance.yaml must be mirrored in
    `_FALLBACK_PERSONA_TO_BINDING` (tools/agent_role_map.py), enforced by
    `test_binding_fallback_never_contradicts_instance_yaml`. The
    structural guard test is live (T-3210); this gate turns it into a
    pre-commit surface instead of a post-push CI red ("nobody smokes it
    because it is just config").

    Runs in-process via unittest's TestLoader — same shape as
    `_priority_list_validate_findings` above (imports over subprocess to
    avoid `agent/*` branch refusal that some CLIs enforce).

    Returns BLOCKING finding strings (empty = clean), or None on
    infrastructural error (fail-OPEN, same shape as other findings).
    Cheap-skips ([]) when instance.yaml isn't staged.
    """
    if "instance.yaml" not in staged:
        return []

    try:
        import io
        import unittest
    except Exception as exc:  # fail-OPEN
        print(
            "instance-yaml-binding-smoke WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — SKIPPING, commit allowed",
            file=sys.stderr,
        )
        return None

    modules = ("tools.test_instance_role_grants", "tools.test_agent_role_map")
    try:
        loader = unittest.TestLoader()
        suite = unittest.TestSuite()
        for mod_name in modules:
            suite.addTests(loader.loadTestsFromName(mod_name))
        buf = io.StringIO()
        runner = unittest.TextTestRunner(stream=buf, verbosity=1)
        result = runner.run(suite)
    except Exception as exc:  # fail-OPEN on infrastructural failure
        print(
            "instance-yaml-binding-smoke WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — SKIPPING, commit allowed",
            file=sys.stderr,
        )
        return None

    if result.wasSuccessful():
        return []

    findings: list[str] = []
    for failed_test, tb in list(result.failures) + list(result.errors):
        tb_lines = [ln for ln in tb.strip().splitlines() if ln.strip()]
        last = tb_lines[-1] if tb_lines else "failure"
        findings.append(f"{failed_test.id()}: {last}")
    return findings


def _read_head_blob(path: str) -> bytes | None:
    """HEAD's blob for `path` via `git show HEAD:<path>`; None if absent at HEAD
    (a new file, or an unborn HEAD)."""
    result = subprocess.run(
        ["git", "show", f"HEAD:{path}"],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    return result.stdout


def _rename_source(path: str) -> str | None:
    """The path `path` was renamed FROM in the staged diff, or None.

    A fresh per-lookup `_staged_changes()` (never a module-level cache, which would
    go stale across repos in a single test process). `main()` does NOT use this: it
    computes the `{dest: source}` map once and threads it to the checks that need
    it; this is the fallback for a caller that passes no map."""
    return _rename_map(_staged_changes()).get(path)


def _content_gate_findings(
    staged: list[str], rename_sources: dict[str, str] | None = None
) -> list[str] | None:
    """Writer-side gate for the two content-coupled nightly invariants (T-4402).

    When a staged path is a ticket file or `knowledge/watch/topics.md`, run the same
    predicates the nightly's live-corpus tests use (ticket `project_id` justification;
    active-topic TOPIC_POLICY registration) against the STAGED blobs, and refuse only a
    violation INTRODUCED by this commit (compared with HEAD, following a rename to its
    source). The logic lives in `tools/staged_content_gate.py`; this is the thin adapter.

    `rename_sources` is the `{dest: source}` map `main()` computed once from the
    staged diff (T-4451); None falls back to a per-lookup `_rename_source`.

    Returns finding strings (empty = clean), or None when the gate itself could not
    run (import failure or an unexpected crash) -- fail-OPEN, mirroring the other
    findings functions: this hook gates every seat's commits, and a bug here must
    never brick filing (T-1102 blast radius). Cheap-skips (`[]`, no import) when no
    staged path is a ticket file or topics.md -- the overwhelmingly common commit.
    """
    if not any(
        p == "knowledge/watch/topics.md" or (p.startswith("tickets/") and p.endswith(".md"))
        for p in staged
    ):
        return []

    try:
        from tools.staged_content_gate import content_gate_findings
    except Exception as exc:  # fail-OPEN: module unavailable, nothing to evaluate
        print(
            "content-drift gate WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — staged_content_gate unavailable, "
            "SKIPPING the content-drift gate, commit allowed",
            file=sys.stderr,
        )
        return None

    try:
        return content_gate_findings(
            staged,
            read_staged=_read_staged_blob,
            read_head=_read_head_blob,
            rename_source=_rename_source if rename_sources is None else rename_sources.get,
            tickets_root=_REPO_ROOT / "tickets",
        )
    except Exception as exc:  # fail-OPEN: a genuine bug in the gate itself
        print(
            "content-drift gate WARNING (non-blocking, fail-open): "
            f"{exc.__class__.__name__}: {exc} — SKIPPING the content-drift gate, "
            "commit allowed",
            file=sys.stderr,
        )
        return None


def _hook_allowlist_drift() -> tuple[str, list[str]] | None:
    """Blocking hook<->allowlist pairing guard (T-1102).

    Returns (agent, deviations) when the committing agent has hook(s) wired in its
    own settings.json that are not in HOOK_ALLOWLIST — else None. Fail-OPEN on any
    error (a lint bug must never brick commits, like the rest of this hook).
    """
    try:
        from tools.hook_allowlist_lint import lint, local_agent

        agent = local_agent()
        if agent is None:
            return None
        deviations = lint(agent)
        return (agent, deviations) if deviations else None
    except Exception:
        return None


def _bugs_verification_findings() -> list[str]:
    """T-4562: a bugs/*.md the commit ADDS must carry a `## Verification` section
    (template-forward: modified legacy entries are not checked). The rule lives in
    tools/bugs_entry_lint.py; this is the thin adapter. Fail-open on a git error."""
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=A", "-z"],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return []
    added = [p for p in result.stdout.decode("utf-8", "surrogateescape").split("\0") if p]
    from tools.bugs_entry_lint import findings, is_entry

    entries = {}
    for path in added:
        if not is_entry(path):
            continue
        blob = _read_staged_blob(path)
        if blob is not None:
            entries[path] = blob.decode("utf-8", "replace")
    return findings(entries)


def main() -> int:
    failures: list[str] = []

    changes = _staged_changes()
    staged = [path for path, _source in changes]
    # {destination: rename source}, computed once (T-4451) for the checks that
    # compare a renamed blob against its pre-rename identity.
    rename_sources = _rename_map(changes)
    for path in staged:
        blob = _read_staged_blob(path)
        if blob is None:
            continue
        ok, detail = _scan_blob(blob, path)
        if not ok:
            failures.append(detail)

    _warn_directive_drift(staged)

    drift = _hook_allowlist_drift()
    if drift is not None:
        from tools.hook_allowlist_lint import format_failure

        print(format_failure(drift[0], drift[1]), file=sys.stderr)

    main_guard_findings = _main_guard_lint_findings(staged)
    self_sudo_guard_findings = _self_sudo_guard_findings(staged, rename_sources)
    ledger_validity_findings = _ledger_validity_findings(staged)
    priority_list_findings = _priority_list_validate_findings(staged)
    instance_yaml_findings = _instance_yaml_binding_findings(staged)
    content_gate_findings = _content_gate_findings(staged, rename_sources)
    bugs_verification_findings = _bugs_verification_findings()

    if failures:
        print("", file=sys.stderr)
        print("HERMES discipline violation — commit refused.", file=sys.stderr)
