#!/usr/bin/env python3
"""commit-msg hook: refuse any commit whose message contains the unescaped
HERMES trigger byte sequence.

Receives the path to the commit message file as $1 (sys.argv[1]).  Reads the
full message and scans it via the same `_hermes_scan_message` helper used by
the application-level guards in `tools/_git_utils.py`.

Covers both the `git commit -m "..."` path and the interactive-editor path
(`git commit` without -m), since the commit-msg hook fires after the editor
closes in both cases.

Source-cleanliness convention: the trigger byte sequence is never written
contiguously in this source file.  See the companion `pre-commit` hook and
`tools/_git_utils.py` for the canonical convention rationale.

Verification: `grep -cF` for the unescaped form against this file must
return 0.

Activation:
    git config core.hooksPath .githooks
    (or run tools/install_hooks.sh which does this idempotently)
"""

from __future__ import annotations

import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# Bootstrap: add repo root to sys.path so `tools._git_utils` is importable.
# ---------------------------------------------------------------------------

_HOOK = Path(__file__).resolve()
_REPO_ROOT = _HOOK.parent.parent  # .githooks/../ == repo root
sys.path.insert(0, str(_REPO_ROOT))

from tools._git_utils import _hermes_scan_message  # noqa: E402


def _forward_ref_failures(message: str) -> list[str]:
    """T-2404: ticket ids cited here but absent from the would-be commit tree.

    Folded into THIS hook rather than shipped as its own file because git runs
    exactly one commit-msg hook — a second script in .githooks/ would be
    silently ignored, and the check would look installed while doing nothing.

    Import-wrapped and exception-swallowing: this gate is an addition to a hook
    whose existing HERMES duty is the more important one, and a broken import
    here must never take that gate — or the ability to commit — down with it.
    """
    try:
        from tools.forward_ref_gate import find_forward_refs, tickets_in_tree
        return find_forward_refs(message, tickets_in_tree())
    except Exception:  # noqa: BLE001
        return []


def main() -> int:
    if len(sys.argv) < 2:
        # git always passes the message file path; if missing, allow through
        # (defensive — don't block commits due to hook misconfiguration).
        return 0

    msg_path = Path(sys.argv[1])
    try:
        message = msg_path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        # Can't read the message file — allow through defensively.
        return 0

    # Checked FIRST and independently: the HERMES gate predates this file's
    # second duty and must not be reachable-only-if the newer check passes.
    missing = _forward_ref_failures(message)

    if not _hermes_scan_message(message):
        print("", file=sys.stderr)
        print("HERMES discipline violation in commit message — commit refused.", file=sys.stderr)
        print("", file=sys.stderr)
        print(
            "  The commit message contains the unescaped trigger byte sequence.",
            file=sys.stderr,
        )
        print(
            "  Escape the period (HERMES\\.md) per CLAUDE.md byte-sequence discipline.",
            file=sys.stderr,
        )
        print("  Edit the message and retry.", file=sys.stderr)
        print("", file=sys.stderr)
        return 1

    if missing:
        from tools.forward_ref_gate import _guidance
        sys.stderr.write(_guidance(missing))
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
