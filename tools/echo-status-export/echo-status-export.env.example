# T-4420 echo-status-export settings. Copy to ~/.config/echo-status-export.env
# on the claude account and chmod 600. Example values only.
#
# MQTT broker the Echo daemon uses (the [mqtt] section of its echo.toml).
# Only host:port is written to the export; username/password never are.
ECHO_MQTT_HOST=127.0.0.1
ECHO_MQTT_PORT=1883
# Leave both empty for an anonymous broker.
ECHO_MQTT_USERNAME=
ECHO_MQTT_PASSWORD=
# Seconds to wait for the daemon's reply before writing {"error": "no reply"}.
# Values above 20 are capped at 20 (the unit's TimeoutStartSec budget).
ECHO_STATUS_TIMEOUT_S=10
#
# Status request/reply topics (T-4431). Unset or empty = the shared
# config-control pair echo/config/request / echo/config/reply. Once the daemon
# serves its read-only status pair (T-4431 Layer 2) and the broker ACL limits
# this user to it, uncomment BOTH. Only these two pairs are accepted; any other
# value or a mixed pair is a bad-config error.
#ECHO_STATUS_REQUEST_TOPIC=echo/config/status/request
#ECHO_STATUS_REPLY_TOPIC=echo/config/status/reply
#
# Optional: path to the deployed echo binary (the one run-echo.sh execs).
# Its sha256 + mtime go into the export as the build identity, because the
# status snapshot has no version field. Leave empty to skip.
ECHO_BIN=
#
# journald unit of the live daemon and whether it is a --user or system unit.
ECHO_JOURNAL_UNIT=echo.service
ECHO_JOURNAL_SCOPE=user
#
# Output dir and group. The script creates the dir (claude-owned, mode 2750)
# inside the setgid pantheon-shared parent; the group is a fallback for a dir
# that did not inherit it. Readers can read but not replace the files.
ECHO_EXPORT_DIR=/var/lib/pantheon/echo-evidence/status
ECHO_EXPORT_GROUP=pantheon-shared
