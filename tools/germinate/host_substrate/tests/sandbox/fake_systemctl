#!/usr/bin/python3 -I
"""FAKE systemctl, bind-mounted over /usr/bin/systemctl INSIDE the T-2918 sandbox only.

systemd (PID 1) does not run in a user namespace. `enable|disable <unit>`
creates/removes the multi-user.target.wants symlink a real enable produces
(refusing a unit file that is not installed); `daemon-reload` and
`reload dbus.service` are logged only. Every argv is logged. Evidence from it
is "fake-port tier" (ORG-052 gate 8); real activation is T-2924's.
"""
import os
import sys

LOG = "/var/lib/systemd/pantheon-fake-systemd.log"
UNITS = "/etc/systemd/system"
WANTS = os.path.join(UNITS, "multi-user.target.wants")
with open(LOG, "a", encoding="utf-8") as log:
    log.write("systemctl " + " ".join(sys.argv[1:]) + "\n")
args = sys.argv[1:]
if args == ["daemon-reload"] or args == ["reload", "dbus.service"]:
    sys.exit(0)
if len(args) == 2 and args[0] in ("enable", "disable"):
    unit = args[1]
    if "/" in unit or not os.path.exists(os.path.join(UNITS, unit)):
        sys.stderr.write(f"Failed to {args[0]} unit: Unit file {unit} does not exist.\n")
        sys.exit(1)
    link = os.path.join(WANTS, unit)
    os.makedirs(WANTS, exist_ok=True)
    if args[0] == "enable" and not os.path.lexists(link):
        os.symlink(os.path.join(UNITS, unit), link)
    elif args[0] == "disable" and os.path.lexists(link):
        os.unlink(link)
    sys.exit(0)
sys.stderr.write("fake systemctl: unsupported invocation\n")
sys.exit(1)
