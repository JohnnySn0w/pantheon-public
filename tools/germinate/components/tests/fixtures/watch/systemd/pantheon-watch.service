[Unit]
Description=Pantheon watch-loop driver — due-detector that files an in-session watch-dispatch ticket (ORG-025)
Documentation=file:///home/%u/pantheon-config/knowledge/watch/README.md
After=network-online.target
Wants=network-online.target

# Silent-failure guard (T-1868, repo-templated per T-1928): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PANTHEON_CLAUDE_BIN=%h/.npm-global/bin/claude
Environment=PATH=%h/.npm-global/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/watch_runner.py --file-watch-ticket
StandardOutput=journal
StandardError=journal
TimeoutStartSec=4h
