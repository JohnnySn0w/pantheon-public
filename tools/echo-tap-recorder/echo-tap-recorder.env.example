# T-5260 echo-tap-recorder settings. Copy to ~/.config/echo-tap-recorder.env
# on the claude account and chmod 600. Example values only.
#
# MQTT broker the Echo daemon uses (the [mqtt] section of its echo.toml).
# Same names as echo-status-export.env. The password is read from this file
# only: it never goes on a command line and is never logged.
ECHO_MQTT_HOST=127.0.0.1
ECHO_MQTT_PORT=1883
# Leave both empty for an anonymous broker (the live broker today).
ECHO_MQTT_USERNAME=
ECHO_MQTT_PASSWORD=
#
# Output dir and group. The script creates the dir (claude-owned, mode 2750)
# inside the setgid pantheon-shared parent; the group is a fallback for a dir
# that did not inherit it. Readers can read but not replace the files.
ECHO_TAP_DIR=/var/lib/pantheon/echo-evidence/tap
ECHO_TAP_GROUP=pantheon-shared
#
# Retention, applied at startup and on every hourly rotation: delete files
# whose hour ended more than this many days ago, then delete the oldest until
# the total is at most ECHO_TAP_MAX_BYTES. The current hour's file is kept.
ECHO_TAP_RETENTION_DAYS=7
ECHO_TAP_MAX_BYTES=2147483648
#
# Payloads larger than this are not written; a stub record
# {"ts", "topic", "dropped": "oversize", "bytes": N} is written instead.
ECHO_TAP_MAX_PAYLOAD_BYTES=65536
#
# Comma-separated tap names (the part after echo/<ctx>/tap/) that are dropped
# and counted, never written. tts_raw carries base64 TTS PCM. Setting this
# REPLACES the default, so keep tts_raw in the list.
ECHO_TAP_EXCLUDE=tts_raw
#
# fsync cadence in seconds (the file is also fsynced on rotation and on
# shutdown), and the interval of the stats line written to the journal.
ECHO_TAP_FSYNC_S=60
ECHO_TAP_STATS_S=600
