#!/bin/bash
# pantheon-sudo: run a command under sudo using this seat's password file, without the
# password ever passing through an agent's command text or output (T-5331).
#
#   tools/pantheon-sudo systemctl restart foo
#   tools/pantheon-sudo -u codex bash -c 'cd ~ && git status'
#
# Arguments go straight to sudo after `-S -k -p ''`, so sudo options (-u USER, ...) work.
# The command's stdin is the password pipe, already at EOF, exactly as with the
# hand-written `tr -d '\n' < <file> | sudo -S ...` form it replaces. Commands that need
# their own stdin should read a file instead.
#
# tools/hooks/root-env-guard.py refuses agent commands that name the password file or pass
# `sudo -S`, which leaves this wrapper as the one working path. It is a text-level guard
# against accidental leaks into transcripts (ORG-105 sec.4), not a sandbox.
set -euo pipefail

PW_FILE="${PANTHEON_SUDO_PW_FILE:-$HOME/root.env}"

if [ "$#" -eq 0 ]; then
  echo "usage: pantheon-sudo <command> [args...]" >&2
  exit 64
fi
if [ ! -r "$PW_FILE" ]; then
  echo "pantheon-sudo: password file not readable for $(id -un)" >&2
  exit 65
fi

exec sudo -S -k -p '' "$@" < <(tr -d '\n' < "$PW_FILE")
