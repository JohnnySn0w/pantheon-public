  "packages_verify": ["python3", "python3-dbus", "python3-gi", "python3-yaml"],
  "runtimes": {
    "host": {"prefix": "/usr/local/lib/pantheon/host-mcp-adapter", "launcher": "/usr/local/libexec/pantheon-host-mcp-adapter"},
    "approval": {"prefix": "/usr/local/lib/pantheon/approval-mcp-adapter", "launcher": "/usr/local/libexec/pantheon-approval-mcp-adapter"}
  },
  "producer": {"user": "nobody", "group": "nogroup", "via": "setpriv"}
