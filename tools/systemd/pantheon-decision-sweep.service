[Unit]
Description=Pantheon decision-register sweep (T-5015 phase 2) — files one ticket for the operator rulings in chat that have no register row
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md
After=network-online.target
Wants=network-online.target

# Silent-failure guard (T-1868): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/operator_decision_sweep.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=10min
