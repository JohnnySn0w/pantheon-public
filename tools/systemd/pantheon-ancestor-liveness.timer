[Unit]
Description=Pantheon the-ancestor liveness monitor — every 10 min alive-but-wedged probe (T-1134)
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md

[Timer]
OnCalendar=*-*-* *:0/10:00
Persistent=false
Unit=pantheon-ancestor-liveness.service

[Install]
WantedBy=timers.target
