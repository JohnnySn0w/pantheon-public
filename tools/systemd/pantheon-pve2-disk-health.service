[Unit]
Description=Pantheon pve2 disk health — raw SMART defects, wear, write rate, kernel ATA errors (T-4997)
Documentation=file:///home/%u/pantheon-config/tools/disk_health_monitor.py
After=network-online.target

# Never keys on the SMART PASSED verdict; this check failing IS the alert.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/disk_health_monitor.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5min

[Install]
WantedBy=default.target
