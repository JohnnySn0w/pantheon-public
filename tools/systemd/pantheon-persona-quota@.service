[Unit]
Description=Pantheon planned quota check for persona %i
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PANTHEON_INSTANCE_MANIFEST=%h/pantheon-config/instance.yaml
Environment=PANTHEON_HARNESS_HOME=%h
Environment=PANTHEON_PERSONA_CWD=%h/pantheon-config
Environment=PANTHEON_MAILBOX_HUB=/home/post-office/mailbox
Environment=PANTHEON_PERSONA_STATE_DIR=%h/.local/state/pantheon/personas
ExecStart=/usr/bin/sg pantheon-mailbox -c "/usr/bin/python3 %h/pantheon-config/tools/persona_bringup.py quota-check --persona %i"
TimeoutStartSec=5min
