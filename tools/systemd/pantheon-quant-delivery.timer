[Unit]
Description=Pantheon ORG-102 delivery quantification collector timer (T-4780)
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md

[Timer]
OnCalendar=*-*-* 06:23:00
Persistent=true
RandomizedDelaySec=300
Unit=pantheon-quant-delivery.service

[Install]
WantedBy=timers.target
