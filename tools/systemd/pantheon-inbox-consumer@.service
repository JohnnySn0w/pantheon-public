[Unit]
Description=Pantheon inbox auto-consumer — one-shot cycle for %i
Documentation=file:///home/%u/pantheon-config/notes/autonomy.md
After=network.target

# Silent-failure guard (T-1868, repo-templated per T-1928): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=%h/.npm-global/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/inbox_consumer.py --agent %i
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5min
