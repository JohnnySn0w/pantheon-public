[Unit]
Description=Pantheon decision throughline trigger (T-5015 phase 3) — files one ticket when the decision register has gained rows since the last pass
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md
After=network-online.target
Wants=network-online.target

# Silent-failure guard (T-1868): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/operator_decision_throughline.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=10min
