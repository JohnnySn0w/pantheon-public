[Unit]
Description=Pantheon OAuth-credential-expiry monitor — detect an agent that cannot auth (empty/missing refresh token, malformed cred) BEFORE it 401s (Jun-2026 outage prevention)
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md

# Silent-failure guard (T-1868): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# ORG-076 §7 per-persona notify-mute registry (T-2978/T-2987 go-live). Supersedes the
# legacy PANTHEON_CRED_ALERT_SKIP env (retired at this go-live). Fail-open if absent.
Environment=PANTHEON_MUTE_REGISTRY=/var/lib/pantheon/notify-mute/notify_mute.json
# Pure file-read of every agent's ~/.claude/.credentials.json (no LLM, no Claude
# API) — so it keeps working during a full auth outage and alerts the operator DIRECTLY
# via the Telegram bot token (independent of Claude OAuth). Flags NO_REFRESH (the
# exact Specialist failure: empty refresh token -> hard 401 at access-token expiry) and
# MALFORMED creds; access-token near/post expiry WITH a valid refresh token is
# normal auto-renew and is NOT alerted. Runs on recovery; cross-account reads via sudo.
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/credential_expiry_monitor.py --all
StandardOutput=journal
StandardError=journal
TimeoutStartSec=2min
