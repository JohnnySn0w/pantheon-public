[Unit]
Description=Pantheon watch-loop digest — summarizes the day's reports to Telegram
Documentation=file:///home/%u/pantheon-config/knowledge/watch/README.md
After=network-online.target pantheon-watch.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PANTHEON_TELEGRAM_ENV=/home/claude/.claude/channels/telegram/pantheon.env
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/watch_digest.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=5min
