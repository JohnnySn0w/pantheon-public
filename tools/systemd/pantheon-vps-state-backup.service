[Unit]
Description=Pantheon VPS non-git state backup — off-box copy of the irreplaceable non-git state (T-2178)
Documentation=file:///home/claude/pantheon-config/tickets/done/T-2178.md
After=network-online.target
Wants=network-online.target

# NO OnFailure= here is DELIBERATE (this unit is on the EXCLUDED list in
# test_unit_failure_alert_coverage.py): it is a system/root unit, and the fleet
# OnFailure alerter + failed-unit-reconcile are both user-scoped (per-account
# systemctl --user) — neither fires for a system unit. A backup's real health
# signal is commit-freshness, not unit status: any failure shows as a missing
# daily commit in the backup repo. The staleness monitor that alerts on that is
# T-2886.

[Service]
# SYSTEM unit (installed at /etc/systemd/system/, runs as root): the backup
# reads every account's home state + /etc + the kino DB, which no single agent
# account can. The canonical script is tracked at tools/vps_state_backup.sh, but
# root runs a ROOT-OWNED COPY (T-4575): the checkout is claude-writable, so any
# claude process editing it would otherwise get root at the next run. After a
# merge that changes the script, reinstall:
#   sudo install -o root -g root -m 0755 \
#     /home/claude/pantheon-config/tools/vps_state_backup.sh \
#     /usr/local/sbin/pantheon-vps-state-backup
# pantheon-backup-staleness.service (daily, user unit) fails and alerts while the
# copy is missing, differs, or is not a root-owned, owner-only-writable regular
# file, so it can't drift past the next daily check.
# T-5993 ORG-101 mirror leg: the script imports _git_utils only from a root-owned
# lib (inert and logged as 'skipped' while it is absent). After a merge that
# changes tools/_git_utils.py, tools/remote_resolve.py or repos.yaml, reinstall:
#   sudo install -d -o root -g root -m 0755 /usr/local/lib/pantheon-vps-backup/tools
#   for f in tools/_git_utils.py tools/remote_resolve.py repos.yaml; do
#     sudo install -o root -g root -m 0644 /home/claude/pantheon-config/$f \
#       /usr/local/lib/pantheon-vps-backup/$f; done
# then re-pin root's /root/.local/state/pantheon/repos.yaml.pin (tools/manifest_pin.py).
# The staleness check fails the same way on lib drift once the lib exists.
Type=oneshot
# T-5993: a system unit with no User= runs with HOME unset, so git never reads
# /root/.gitconfig and the ORG-101 mirror leg's credential helper is invisible
# ("could not read Password"). Pin HOME so root's global git config applies.
Environment=HOME=/root
ExecStart=/usr/bin/bash /usr/local/sbin/pantheon-vps-state-backup
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min
