[Unit]
Description=Pantheon the-ancestor daemon — channel-less Veneration substrate + mailbox node (T-0765)
Documentation=file:///home/the-ancestor/pantheon-config/tickets/inbox/T-0765.md
After=network.target

# Silent-failure guard (T-1868, repo-templated per T-1928): on failure, wake Recovery via the ORG-026 mailbox.
# T-2264 sweep: same shape as pantheon-acp-bridge@ (Type=simple + supervise wrapper + Restart=always +
# mailbox-substrate-critical), and the same invisibility risk — a wrapper that respawns forever turns a
# hard failure into silence. the-ancestor already has pantheon-unit-failure-alert@.service installed, so
# this resolves on deploy. NOT added to pantheon-resource-sampler.service in the same sweep: that unit
# documents its own deliberate exclusion (an evidence recorder must not make the mailbox a dependency of
# recording, and it exits 0 by design).
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
# Supervised wrapper (NOT Type=oneshot): the wrapper stays alive as MainPID for as long
# as the tmux session lives, so a dead session => wrapper exits => Restart=always respawns
# it. (Type=oneshot + RemainAfterExit was the ~14h inert-daemon outage on Recovery, 2026-05-21.)
Type=simple
ExecStart=%h/pantheon-config/tools/ancestor-bot-supervise.sh
Restart=always
RestartSec=5
# Thin/idle by design; no channels, no bot token (the channel-less safety invariant).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
