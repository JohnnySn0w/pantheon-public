[Unit]
Description=Pantheon the-ancestor liveness monitor — detect an alive-but-wedged the-ancestor daemon (T-1134)
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Probes the-ancestor's `ancestor-daemon` tmux pane (Recovery -> sudo -u the-ancestor). DETECT +
# ALERT run live: a confirmed wedge (N consecutive not-alive probes) routes via
# route_failure_alert -> Recovery (the-ancestor is channel-less, no bridge).
# ARMED 2026-06-15 (T-1134-arming, supervised first-fire — the operator msg 3287 "sure shoot"):
# auto-RESTART now LIVE. Only fires on N consecutive not-alive probes (confirmed wedge),
# bounded by a >=30min cooldown (anti-loop); a healthy daemon reads 'alive' and no-ops.
# Runs on Recovery (claude-fallback); the-ancestor recovery is Recovery's per T-0765 del.6.
Environment=PANTHEON_ANCESTOR_REMEDIATE_ENABLED=1
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/ancestor_liveness_monitor.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1min
