[Unit]
Description=Pantheon ticket-grooming — daily staleness scan + digest
Documentation=file:///home/%u/pantheon-config/tickets/README.md
After=network-online.target
Wants=network-online.target

# Silent-failure guard (T-1868): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/ticket_grooming.py --commit-prod
StandardOutput=journal
StandardError=journal
TimeoutStartSec=10min
