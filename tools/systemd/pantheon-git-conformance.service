[Unit]
Description=Pantheon git conformance sweep — daily read-only check of the ORG-101 redundancy standard (T-4690)
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md
After=network-online.target
Wants=network-online.target
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/sg pantheon-mailbox -c "/usr/bin/python3 %h/pantheon-config/tools/git_conformance_sweep.py"
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min
