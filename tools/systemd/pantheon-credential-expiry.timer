[Unit]
Description=Pantheon credential-expiry monitor — hourly OAuth-credential health probe (Jun-2026 outage prevention)
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md

[Timer]
OnCalendar=*-*-* *:35:00
Persistent=true
Unit=pantheon-credential-expiry.service

[Install]
WantedBy=timers.target
