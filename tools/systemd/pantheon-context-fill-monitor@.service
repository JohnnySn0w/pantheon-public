[Unit]
Description=Pantheon context-fill monitor for %i — poll session jsonl, fire graceful restart at min(500k absolute, 0.70×window) tokens (T-1497)
Documentation=file:///home/%u/pantheon-config/tools/systemd/README.md
After=network.target

# Silent-failure guard (T-1868, repo-templated per T-1928): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
Environment=PATH=%h/.npm-global/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
# ORG-076 §7 per-persona notify-mute registry (T-2978/T-2987 go-live). The shared,
# non-root, pantheon-mailbox-group-readable location under the ORG-026 hub; every
# per-agent alert path consults notify_policy.is_muted against it (fail-open if absent).
Environment=PANTHEON_MUTE_REGISTRY=/var/lib/pantheon/notify-mute/notify_mute.json
ExecStart=/usr/bin/python3 %h/pantheon-config/tools/context_fill_monitor.py --agent %i
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min
