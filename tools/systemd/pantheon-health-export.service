[Unit]
Description=Pantheon fleet health exporter: sanitized enum-only per-persona health (T-4884 B2)
Documentation=file:///home/%u/pantheon-config/notes/2026-10-12-t4884-codex-recovery-seat-design.md

# NOT auto-installed by any provision script. Template only (T-4884 B2). Runs on
# the Recovery account (claude-fallback), which already holds `sudo -n -u <acct>`
# to the fleet accounts; the exporter reads each persona's state through that
# and publishes only enums/ints/bounded identifiers.
#
# Output dir: the default --out-dir /run/pantheon-health is created by root via
# tmpfiles, NOT by this unit or by tools/health_export.py:
#     d /run/pantheon-health 2750 claude-fallback pantheon-health -
# That line (and group pantheon-health = {claude-fallback, codex-fallback}) is
# root-provisioned later (B7/B11). Until it exists the service exits 2
# ("out-dir not writable"), which is the intended loud failure.

# Silent-failure guard (T-1868): on failure, wake Recovery via the ORG-026 mailbox.
OnFailure=pantheon-unit-failure-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/pantheon-config
# `sg pantheon-mailbox -c` is REQUIRED for the same reason as
# pantheon-acp-bridge-backlog@.service (T-1015): a --user unit runs with only the
# account's primary group, and the mailbox hub is group pantheon-mailbox. Without
# it mail_unread is null for every persona (read failure, never a false zero).
ExecStart=/usr/bin/sg pantheon-mailbox -c "/usr/bin/python3 %h/pantheon-config/tools/health_export.py"
StandardOutput=journal
StandardError=journal
TimeoutStartSec=50s
